# Config generated by Ghostty Config
# https://ghostty.zerebos.com

theme = TokyoNight Night
font-family = UDEV Gothic 35NF
font-size = 11
font-style = bold
font-thicken = true
adjust-cell-width = -20%
adjust-cell-height = 25%

cursor-style-blink = false

# Kitty protocol (https://sw.kovidgoyal.net/kitty/keyboard-protocol/)
keybind = ctrl+tab=esc:[9;5u
keybind = ctrl+shift+tab=esc:[9;6u
