#!/usr/bin/env zsh

zparseopts -D -E - -amend=opt_amend -no-resume=opt_no_resume

skill="headless-commit"
if (( $#opt_amend )); then
  skill="headless-commit-amend"
fi

head_before=$(git rev-parse HEAD 2>/dev/null)

session_id=$(uuidgen)

HERDR_ENV= HERDR_SOCKET_PATH= HERDR_PANE_ID= claude --print --session-id "$session_id" --verbose --model haiku --output-format stream-json -p "/$skill $*" \
  | jq -r 'select(.type == "assistant") | .message.content[]? | select(.type? == "text") | .text'

head_after=$(git rev-parse HEAD 2>/dev/null)
if [[ "$head_before" != "$head_after" ]]; then
  exit 0
fi

if (( $#opt_no_resume )); then
  echo "commit failed. Resume with: claude --resume $session_id" >&2
  exit 1
fi

claude --resume "$session_id"
